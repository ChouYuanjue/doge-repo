diff --git a/tests/test_cache_windows.py b/tests/test_cache_windows.py
new file mode 100644
index 0000000000000000000000000000000000000000..89c6858520c5620bf4f146236ac1fffd4e8dbe14
--- /dev/null
+++ b/tests/test_cache_windows.py
@@ -0,0 +1,128 @@
+from __future__ import annotations
+
+import json
+import unittest
+import asyncio
+from pathlib import Path
+from types import SimpleNamespace
+
+from utils.context_manager import ContextManager
+from utils.decision_ai import DecisionAI
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def _msg(i: int):
+    return SimpleNamespace(
+        message_id=f"m{i}",
+        timestamp=1_700_000_000 + i,
+        message_str=f"message {i}",
+        sender=SimpleNamespace(user_id=str(i % 5)),
+    )
+
+
+class CacheWindowTests(unittest.TestCase):
+    def setUp(self):
+        ContextManager._cache_window_anchors.clear()
+
+    def test_keeps_same_anchor_while_appending(self):
+        rows = [_msg(i) for i in range(80)]
+        visible = ContextManager.cache_aware_history_window("reply:g", rows, low=48, high=72)
+        self.assertEqual(len(visible), 48)
+        self.assertEqual(visible[0].message_id, "m32")
+        for i in range(80, 104):
+            rows.append(_msg(i))
+            visible = ContextManager.cache_aware_history_window("reply:g", rows, low=48, high=72)
+            self.assertEqual(visible[0].message_id, "m32")
+            self.assertEqual(visible[-1].message_id, f"m{i}")
+            self.assertLessEqual(len(visible), 72)
+
+    def test_reanchors_once_after_high_watermark(self):
+        rows = [_msg(i) for i in range(80)]
+        ContextManager.cache_aware_history_window("reply:g", rows, low=48, high=72)
+        rows.extend(_msg(i) for i in range(80, 105))
+        visible = ContextManager.cache_aware_history_window("reply:g", rows, low=48, high=72)
+        self.assertEqual(len(visible), 48)
+        self.assertEqual(visible[0].message_id, "m57")
+        self.assertEqual(visible[-1].message_id, "m104")
+        rows.append(_msg(105))
+        nxt = ContextManager.cache_aware_history_window("reply:g", rows, low=48, high=72)
+        self.assertEqual(nxt[0].message_id, "m57")
+        self.assertEqual(nxt[-1].message_id, "m105")
+
+    def test_never_mutates_durable_history(self):
+        rows = [_msg(i) for i in range(120)]
+        before = [x.message_id for x in rows]
+        visible = ContextManager.cache_aware_history_window("reply:g", rows, low=48, high=72)
+        self.assertEqual(len(visible), 48)
+        self.assertEqual([x.message_id for x in rows], before)
+        self.assertEqual(len(rows), 120)
+
+    def test_decision_and_reply_have_independent_anchors(self):
+        rows = [_msg(i) for i in range(100)]
+        reply = ContextManager.cache_aware_history_window("reply:g", rows, low=48, high=72)
+        decision = ContextManager.cache_aware_history_window("decision:g", reply, low=12, high=18)
+        self.assertEqual(len(reply), 48)
+        self.assertEqual(len(decision), 12)
+        self.assertNotEqual(reply[0].message_id, decision[0].message_id)
+        self.assertEqual(set(ContextManager._cache_window_anchors), {"reply:g", "decision:g"})
+
+    def test_config_defaults_are_bounded_and_enabled(self):
+        schema = json.loads((ROOT / "_conf_schema.json").read_text(encoding="utf-8"))
+        self.assertEqual(schema["max_context_messages"]["default"], 72)
+        self.assertTrue(schema["enable_cache_aware_context"]["default"])
+        self.assertEqual(schema["cache_context_low_messages"]["default"], 48)
+        self.assertEqual(schema["cache_context_high_messages"]["default"], 72)
+        self.assertEqual(schema["decision_context_high_messages"]["default"], 18)
+
+    def test_decision_request_explicitly_disables_native_reasoning(self):
+        class Provider:
+            def __init__(self):
+                self.payload = None
+
+            async def _prepare_chat_payload(self, prompt, image_urls, audio_urls, contexts, system_prompt, tool_calls_result, **kwargs):
+                return ({"model": "deepseek-v4-flash", "messages": [{"role": "system", "content": system_prompt}, {"role": "user", "content": prompt}]}, [])
+
+            async def _query(self, payload, tools, *, request_max_retries=None):
+                self.payload = dict(payload)
+                self.tools = tools
+                self.retries = request_max_retries
+                return SimpleNamespace(completion_text="yes")
+
+        provider = Provider()
+        resp = asyncio.run(DecisionAI._controlled_decision_request(
+            provider, prompt="P", system_prompt="S", image_urls=[], session_id="x", enable_reasoning=False
+        ))
+        self.assertEqual(resp.completion_text, "yes")
+        self.assertEqual(provider.payload["temperature"], 0.0)
+        self.assertEqual(provider.payload["max_tokens"], 64)
+        self.assertEqual(provider.payload["thinking"], {"type": "disabled"})
+        self.assertIsNone(provider.tools)
+        self.assertEqual(provider.retries, 1)
+
+    def test_mood_is_current_turn_tail_not_system_prefix(self):
+        main = (ROOT / "main.py").read_text(encoding="utf-8")
+        self.assertIn("<group-chat-current-mood>", main)
+        self.assertNotIn('req.system_prompt += f"\\n\\n{mood_hint}"', main)
+        self.assertIn('req.extra_user_content_parts.append(', main)
+
+    def test_tool_schema_order_is_canonicalized(self):
+        main = (ROOT / "main.py").read_text(encoding="utf-8")
+        self.assertIn('req.func_tool.tools.sort(key=lambda tool:', main)
+
+    def test_sender_state_is_tail_only(self):
+        reply = (ROOT / "utils" / "reply_handler.py").read_text(encoding="utf-8")
+        decision = (ROOT / "utils" / "decision_ai.py").read_text(encoding="utf-8")
+        self.assertIn("_sender_tail", reply)
+        self.assertIn("_decision_sender_tail", decision)
+        patterns = (
+            '+ sender_emphasis\n                    + "\\n"\n                    + formatted_message',
+            '+ sender_emphasis\n                    + "\\n\\n"\n                    + formatted_message',
+        )
+        for pattern in patterns:
+            self.assertNotIn(pattern, reply)
+            self.assertNotIn(pattern, decision)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/utils/context_manager.py b/utils/context_manager.py
index 877daf952e5ebe75b52682743d0a37763a1368d5..dbb0119b7af54e4904abfcbe38cc050a278068b9 100644
--- a/utils/context_manager.py
+++ b/utils/context_manager.py
@@ -1395,0 +1396,60 @@ class ContextManager:
+    _cache_window_anchors: dict[str, str] = {}
+
+    @staticmethod
+    def _cache_window_message_key(msg) -> str:
+        """Stable-enough key for a stored platform message inside one process."""
+        try:
+            mid = str(getattr(msg, "message_id", "") or "").strip()
+            if mid and not mid.startswith("official_"):
+                return "id:" + mid
+            sender = getattr(msg, "sender", None)
+            sid = str(getattr(sender, "user_id", "") or "")
+            content = ContextManager._content_to_safe_text(getattr(msg, "message_str", "") or "")
+            # Do not include timestamp here: some conversation-history adapters
+            # synthesize ``time.time()`` for timestamp-less rows on every read,
+            # which would make an unchanged anchor look new every request.
+            import hashlib
+            digest = hashlib.sha1(content.encode("utf-8", "ignore")).hexdigest()[:20]
+            return f"fallback:{sid}:{digest}"
+        except Exception:
+            return f"object:{id(msg)}"
+
+    @classmethod
+    def cache_aware_history_window(
+        cls,
+        window_key: str,
+        history_messages: List[AstrBotMessage],
+        *,
+        low: int,
+        high: int,
+    ) -> List[AstrBotMessage]:
+        """Append-only history window with hysteresis for prefix-cache reuse.
+
+        A normal sliding suffix changes its first message on every turn once it
+        reaches capacity, invalidating provider prefix caches continuously. This
+        window keeps the same anchor while it grows from ``low`` to ``high``;
+        only after crossing ``high`` does it jump once to the newest ``low``
+        messages. Full durable history is untouched.
+        """
+        rows = list(history_messages or [])
+        if not rows:
+            cls._cache_window_anchors.pop(str(window_key), None)
+            return []
+        high = max(1, int(high))
+        low = max(1, min(int(low), high))
+        key = str(window_key)
+        anchor = cls._cache_window_anchors.get(key)
+        if anchor:
+            for idx, msg in enumerate(rows):
+                if cls._cache_window_message_key(msg) == anchor:
+                    window = rows[idx:]
+                    if len(window) <= high:
+                        return window
+                    break
+        # First request after restart/anchor loss, or high watermark crossed.
+        # Large histories re-anchor at low; genuinely short histories keep all.
+        window = rows if len(rows) <= high else rows[-low:]
+        if window:
+            cls._cache_window_anchors[key] = cls._cache_window_message_key(window[0])
+        return window
+
