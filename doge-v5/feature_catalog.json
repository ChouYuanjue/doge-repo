{
  "schema": 1,
  "runtime": {
    "astrbot": "4.27.x",
    "python": ">=3.12",
    "qq_adapter": "NapCat/OneBot via AstrBot aiocqhttp",
    "agent_harness": "AstrBot built-in Agent Runner + FunctionTool/add_llm_tools",
    "computer_use": "sandbox preferred; never local for ordinary users"
  },
  "features": [
    {
      "name": "apis",
      "purpose": "杂项外部 API 的统一注册、匹配与调用",
      "from": [
        "v4/apis"
      ],
      "decision": "rework",
      "agent": "later",
      "reason": "保留统一入口的价值，但当前允许任意 URL 且删除配置无权限保护，存在 SSRF/误删风险；还有 data.plugins 硬编码导入。",
      "deploy": []
    },
    {
      "name": "math",
      "purpose": "轻量数学计算、进制转换、π、OEIS 与科学计算入口",
      "from": [
        "v2/random/pi/logic",
        "v3/math",
        "v3/wa",
        "v4/wa"
      ],
      "decision": "native+reuse",
      "agent": "yes",
      "reason": "本地计算可无依赖实现；pi.delivery/OEIS/WolframAlpha 仍可用。将 /wa 保留为兼容后端而不是独立产品概念。",
      "deploy": [
        {
          "source": "plugin",
          "name": "doge_v5"
        },
        {
          "source": "../doge-v4/wa",
          "name": "doge_wa",
          "optional": true
        }
      ]
    },
    {
      "name": "chem",
      "purpose": "化学结构、PubChem 分子信息与 ChEMBL 药物/靶点查询",
      "from": [
        "v3/chem"
      ],
      "decision": "native+official-api",
      "agent": "yes",
      "reason": "NCI Cactus 保留快速结构转换；新增 PubChem 与 ChEMBL 官方 REST，避免安装数据库专用 SDK。",
      "deploy": [
        {
          "source": "plugin",
          "name": "doge_v5"
        }
      ]
    },
    {
      "name": "tex",
      "purpose": "TeX/数学公式渲染，兼顾快速公式与完整宏支持",
      "from": [
        "v3/tex",
        "v4/latex",
        "v4/utex"
      ],
      "decision": "native-v5",
      "agent": "yes",
      "reason": "v5 统一重写命令/service 层：保留原始多行 payload，不再按逗号拆分；默认压缩 UpMath 原生 TeX（align/matrix/TikZ）并异步超时/重试，本地 MathText 提供隐私/断网 fallback；旧 latex/utex 不再默认部署。",
      "deploy": [
        {
          "source": "plugin",
          "name": "doge_v5"
        }
      ]
    },
    {
      "name": "typst",
      "purpose": "Typst 公式、完整文档及聊天记录排版",
      "from": [
        "v4/typst"
      ],
      "decision": "native-v5",
      "agent": "yes",
      "reason": "v5 基于 typst-py 0.15 统一 math/card/doc/chat，支持原始多行输入、多页 PNG、编译错误、包缓存与显式 CJK font_paths；去掉旧 OurChat preview 依赖，旧 doge_typst 不再默认部署。",
      "deploy": [
        {
          "source": "plugin",
          "name": "doge_v5"
        }
      ]
    },
    {
      "name": "chart",
      "purpose": "结构化数据/Chart.js 图表渲染",
      "from": [
        "v3/chart"
      ],
      "decision": "native",
      "agent": "yes",
      "reason": "QuickChart 仍可用；与 Mermaid 的流程图/关系图用途不同。",
      "deploy": [
        {
          "source": "plugin",
          "name": "doge_v5"
        }
      ]
    },
    {
      "name": "mermaid",
      "purpose": "流程图、时序图、类图等语义图表",
      "from": [
        "v4/mermaid"
      ],
      "decision": "reuse",
      "agent": "yes",
      "reason": "现实现成熟且已经接入 LLM Tool，直接复用。",
      "deploy": [
        {
          "source": "../doge-v4/mermaid",
          "name": "doge_mermaid"
        }
      ]
    },
    {
      "name": "complex",
      "purpose": "复函数可视化",
      "from": [
        "v4/complex"
      ],
      "decision": "optional",
      "agent": "later",
