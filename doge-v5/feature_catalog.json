      "agent": "yes",
      "reason": "旧 DeepAI/GAN 专项入口已被现代多模态模型覆盖；统一为 aigen，底层先复用 doubao/liblibapi 和旧别名。",
      "deploy": [
        {
          "source": "../doge-v4/doubao",
          "name": "doge_doubao",
          "optional": true
